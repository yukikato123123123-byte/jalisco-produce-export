{
  "name": "jalisco-produce-export",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --experimental-strip-types tests/prototype.test.mjs",
    "dev:worker": "wrangler dev --config ./wrangler.local.jsonc --local --ip 127.0.0.1 --port 8787",
    "db:local": "wrangler d1 migrations apply DB --config ./wrangler.local.jsonc --local",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "test:auth": "node --experimental-strip-types --test tests/auth.test.mjs",
    "test:browser": "playwright test",
    "check:staging": "node scripts/validate-deployment.mjs staging",
    "check:production": "node scripts/validate-deployment.mjs production",
    "dry-run:staging": "wrangler deploy --dry-run --config ./wrangler.staging.jsonc --outdir ./.wrangler/staging-dry-run",
    "dry-run:production": "wrangler deploy --dry-run --config ./wrangler.production.jsonc --outdir ./.wrangler/production-dry-run",
    "test:deployment": "node --test tests/deployment-config.test.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.20",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "wrangler": "^4.151.3"
  }
}
