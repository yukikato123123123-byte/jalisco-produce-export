    "migrations_dir": "../migrations"
  }],
  "durable_objects": {
    "bindings": [{"name":"OWNER_AUTHORITY","class_name":"OwnerAuthority"}]
  },
  "migrations": [{"tag":"owner-authority-v1","new_sqlite_classes":["OwnerAuthority"]}],
  "vars": {
    "AUTH_ORIGIN": "https://jalisco-auth-staging.yukikato123123123.workers.dev",
    "AUTH_ENVIRONMENT": "staging",
    "SUPABASE_URL": "https://heaswpawzuuijxurlfoz.supabase.co",
    "OWNER_ADMIN_MODE": "owner-admin-grants-v1",
