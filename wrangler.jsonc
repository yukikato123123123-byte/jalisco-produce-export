{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jalisco-auth-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-21",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "jalisco-auth-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "vars": { "AUTH_ORIGIN": "http://localhost:8787" }
}
