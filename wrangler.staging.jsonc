// Isolated project URL supplied; verify its Worker secret and sandbox SMTP before deployment.
// Existing staging account, Worker, origin and D1 are preserved.
// See STAGING_ISOLATION.md. Project ownership and remote Auth settings still require verification.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jalisco-auth-staging",
  "account_id": "89dd3e659cece6bdf3181b991a2a0bd2",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jalisco-auth-staging",
      "database_id": "7712d6bb-2414-44d3-9282-cb5b941d740e",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "AUTH_ORIGIN": "https://jalisco-auth-staging.yukikato123123123.workers.dev",
    "AUTH_ENVIRONMENT": "staging",
    "SUPABASE_URL": "https://heaswpawzuuijxurlfoz.supabase.co"
  }
}
