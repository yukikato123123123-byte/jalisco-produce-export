// LOCAL PREPARATION ONLY. Not deployable until placeholders and hostname policy are reviewed.
// Isolated staging database confirmed by the owner; account/origin remain unconfirmed.
// See STAGING_CONFIGURATION.md. No remote resources have been provisioned.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jalisco-auth-staging",
  "account_id": "REPLACE_WITH_APPROVED_STAGING_ACCOUNT_ID",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-21",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jalisco-auth-staging",
      "database_id": "7712d6bb-2414-44d3-9282-cb5b941d740e",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "AUTH_ORIGIN": "REPLACE_WITH_APPROVED_HTTPS_STAGING_ORIGIN",
    "SUPABASE_URL": "https://xchkkdfelwzzpyorjeks.supabase.co"
  }
}
